{
  "name": "afterimage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "api:install": "npm --prefix api ci",
    "setup:model": "npm --prefix api run setup:model",
    "api": "npm --prefix api start",
    "test:api": "npm --prefix api run test:all",
    "test:integration": "node --experimental-strip-types --test tests/integration.test.mjs",
    "test:render": "node tests/render-ui.mjs",
    "test:smoke": "node --experimental-strip-types tests/reconstructed-model-smoke.mjs",
    "setup:browser-assets": "node scripts/setup-browser-assets.mjs",
    "preview": "vite preview",
    "test:browser": "playwright test",
    "test:evaluation": "node --test docs/evaluation-20261028/artifact.test.mjs docs/evaluation-20261028/scoring.test.mjs",
    "typecheck:browser": "tsc --noEmit --module esnext --moduleResolution bundler --target es2022 --types node --skipLibCheck --allowImportingTsExtensions playwright.config.ts tests/browser/production.spec.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.56.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
